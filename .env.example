
# APP CONFIG
ENV=dev


#  Backend HTTP server CONFIG
PORT=4000
CORS_ALLOWED_ORIGINS="http://localhost:3000"
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=1m


#  DB CONFIG
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=backend
DB_SSL_MODE=disable
DB_MAX_CONNS=20
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m


# OBSERVABILITY
LOG_LEVEL=debug


# REDIS CONFIG
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=